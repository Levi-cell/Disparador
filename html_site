<h1>CALDÃO NORDESTINO</h1>
<p style="text-align:center;font-weight:bold;color:#FFD700;font-size:16px;padding:0 10px;margin-bottom:10px;">Selecione seus caldos e quantidades:</p>

<!-- Elemento de notificação fixo (não será bloqueado como popup) -->
<div id="notification"></div>

<script>
const letras = { 300: "P", 400: "M", 500: "G" };

// Preços originais
const precosOriginais = {
    sururu: { 300: 11.99, 400: 14.99, 500: 16.99 },
    camarao:{ 300: 11.99, 400: 14.99, 500: 16.99 },
    frango: { 300: 9.99, 400: 12.99, 500: 14.99 },
    mocoto: { 300: 9.99, 400: 12.99, 500: 14.99 },
    nord:   { 300: 9.99, 400: 12.99, 500: 14.99 }
};

// Variável para armazenar os preços atuais (com promoções aplicadas)
let precosAtuais = {};

const nomesCaldos = { sururu: "Sururu", camarao: "Camarão", frango: "Frango", mocoto: "Mocotó", nord: "Nordestino" };
const combos = {
    querocaldo: { nome: "Combo QueroCaldo", itens: "Camarão + Sururu (G)", preco: 27.99 },
    caldolover: { nome: "Combo CaldoLover", itens: "Nordestino + Camarão (G)", preco: 25.99 },
    caldolicia: { nome: "Combo Caldolicia", itens: "Frango + Nordestino (G)", preco: 23.99 }
};
const extras = { limao: { nome: "Limão", preco: 0 }, molho: { nome: "Molho", preco: 0 }, torrada: { nome: "Torrada", preco: 1 } };

// Função para obter o dia da semana atual (0=Domingo, 1=Segunda, ..., 6=Sábado)
function getDiaDaSemana() {
    const hoje = new Date();
    return hoje.getDay(); // 0-6
}

// Função para aplicar promoções de acordo com o dia da semana
function aplicarPromocoes() {
    // Copia os preços originais
    precosAtuais = JSON.parse(JSON.stringify(precosOriginais));

    const diaDaSemana = getDiaDaSemana();
    const hoje = new Date();
    const dataFormatada = hoje.toLocaleDateString('pt-BR');

    // Verificar promoções
    let temPromocaoSururu = false;
    let temPromocaoNordestino = false;

    // Quarta-feira (dia 3) - Promoção do Sururu: R$ 3,00 de desconto
    if (diaDaSemana === 3) { // 3 = Quarta-feira
        temPromocaoSururu = true;
        for (let tamanho in precosAtuais.sururu) {
            precosAtuais.sururu[tamanho] = Math.max(0, precosAtuais.sururu[tamanho] - 3);
        }
    }

    // Quinta-feira (dia 4) - Promoção do Nordestino: R$ 3,00 de desconto
    if (diaDaSemana === 4) { // 4 = Quinta-feira
        temPromocaoNordestino = true;
        for (let tamanho in precosAtuais.nord) {
            precosAtuais.nord[tamanho] = Math.max(0, precosAtuais.nord[tamanho] - 3);
        }
    }

    // Atualizar display com informações de promoção
    atualizarDisplayPromocoes(temPromocaoSururu, temPromocaoNordestino, dataFormatada);

    return { temPromocaoSururu, temPromocaoNordestino, dataFormatada };
}

// Função para atualizar o display com informações de promoção
function atualizarDisplayPromocoes(promoSururu, promoNordestino, data) {
    // Atualizar títulos dos cards
    const tituloSururu = document.querySelector('.card:nth-child(1) .titulo');
    const tituloNordestino = document.querySelector('.card:nth-child(5) .titulo');

    if (tituloSururu && promoSururu) {
        tituloSururu.innerHTML = '🥣 Caldo de Sururu <span class="promo-badge">PROMO QUARTA!</span>';
    }

    if (tituloNordestino && promoNordestino) {
        tituloNordestino.innerHTML = '🥣 Caldo Nordestino <span class="promo-badge">PROMO QUINTA!</span>';
    }

    // Adicionar banner de promoção no topo se houver promoção
    const bannerPromocao = document.getElementById('banner-promocao');
    if (promoSururu || promoNordestino) {
        let mensagemPromo = `🏷️ PROMOÇÃO `;
        if (promoSururu) mensagemPromo += "Quarta do Sururuvis, Sururu com R$ 3,00 OFF! ";
        if (promoNordestino) mensagemPromo += "Quinta Nordestina, Nordestino com - R$ 3,00 OFF!";

        if (bannerPromocao) {
            bannerPromocao.textContent = mensagemPromo;
            bannerPromocao.style.display = 'block';
        }
    } else if (bannerPromocao) {
        bannerPromocao.style.display = 'none';
    }
}

// Função para mostrar notificação
function showTemporaryPopup(msg) {
    const notification = document.getElementById("notification");
    notification.innerText = msg;
    notification.style.display = "block";
    notification.style.opacity = "1";
    notification.style.transform = "translateX(-50%) translateY(0)";

    setTimeout(() => {
        notification.style.opacity = "0";
        notification.style.transform = "translateX(-50%) translateY(-20px)";
        setTimeout(() => {
            notification.style.display = "none";
        }, 300);
    }, 2500);
}

// Função para calcular o total atual usando preços atuais (com promoções)
function calcularTotal() {
    let total = 0;

    for (let sabor in precosAtuais) {
        for (let tam in precosAtuais[sabor]) {
            let qtd = parseInt(document.getElementById(`qtd-${sabor}${tam}`).innerText);
            if(qtd > 0) {
                let preco = precosAtuais[sabor][tam];
                total += preco * qtd;
            }
        }
    }

    for (let c in combos) {
        let qtd = parseInt(document.getElementById(`qtd-combo-${c}`).innerText);
        if(qtd > 0) {
            let preco = combos[c].preco;
            total += preco * qtd;
        }
    }

    for (let a in extras) {
        let qtd = parseInt(document.getElementById(`qtd-${a}`).innerText);
        if(qtd > 0 && extras[a].preco > 0) {
            let preco = extras[a].preco;
            total += preco * qtd;
        }
    }

    return total;
}

// Atualizar display do total
function atualizarTotalDisplay() {
    const total = calcularTotal();
    const totalFormatado = total.toFixed(2).replace(".", ",");
    document.getElementById("total-display").innerText = `R$ ${totalFormatado}`;
    document.getElementById("btnPedido").innerHTML = `FINALIZAR PEDIDO (R$ ${totalFormatado})`;
}

// Renderização otimizada para mobile
function renderTabela(sabor, id) {
    let html = `<table class="tabela-caldo"><tr><th>Tamanho</th><th>Preço</th><th>Qtd</th></tr>`;
    for (let tam in precosAtuais[sabor]) {
        let preco = precosAtuais[sabor][tam].toFixed(2).replace(".", ",");
        let precoOriginal = precosOriginais[sabor][tam].toFixed(2).replace(".", ",");

        // Verificar se tem desconto
        const temDesconto = precosAtuais[sabor][tam] < precosOriginais[sabor][tam];

        html += `<tr>
            <td>${letras[tam]} (${tam}ml)</td>
            <td>`;

        if (temDesconto) {
            html += `<span style="text-decoration: line-through; color: #A0522D; font-size: 14px;">R$ ${precoOriginal}</span><br>`;
            html += `<span style="color: #8B4513; font-weight: bold;">R$ <span id="preco-${sabor}${tam}">${preco}</span></span>`;
        } else {
            html += `R$ <span id="preco-${sabor}${tam}">${preco}</span>`;
        }

        html += `</td>
            <td class="qty-cell">
                <div class="qty-btn-container">
                    <button class="qty-btn" onclick="alterarQtd('${sabor}${tam}',-1)">−</button>
                    <span class="qty-number" id="qtd-${sabor}${tam}">0</span>
                    <button class="qty-btn" onclick="alterarQtd('${sabor}${tam}',1)">+</button>
                </div>
            </td>
        </tr>`;
    }
    html += "</table>";
    document.getElementById(id).innerHTML = html;
}

function renderCombos() {
    let html = `<table class="tabela-caldo"><tr><th>Combo</th><th>Preço</th><th>Qtd</th></tr>`;
    for (let c in combos) {
        let combo = combos[c];
        let nomeVisual = combo.nome.replace(/^Combo\s+/i, "").replace("CaldoLover", "CaldoLvr").replace("Caldolicia", "Caldolic");
        html += `<tr>
            <td title="${combo.nome}">${nomeVisual}</td>
            <td>R$ ${combo.preco.toFixed(2).replace(".", ",")}</td>
            <td class="qty-cell">
                <div class="qty-btn-container">
                    <button class="qty-btn" onclick="alterarQtd('combo-${c}',-1)">−</button>
                    <span class="qty-number" id="qtd-combo-${c}">0</span>
                    <button class="qty-btn" onclick="alterarQtd('combo-${c}',1)">+</button>
                </div>
            </td>
        </tr>`;
    }
    html += "</table>";
    document.getElementById("combos-area").innerHTML = html;
}

function renderExtras() {
    let html = `<table class="tabela-caldo"><tr><th>Extras</th><th>Preço</th><th>Qtd</th></tr>`;
    for (let a in extras) {
        let preco = extras[a].preco.toFixed(2).replace(".", ",");
        html += `<tr>
            <td>${extras[a].nome}</td>
            <td>R$ ${preco}</td>
            <td class="qty-cell">
                <div class="qty-btn-container">
                    <button class="qty-btn" onclick="alterarQtdExtra('${a}',-1)">−</button>
                    <span class="qty-number" id="qtd-${a}">0</span>
                    <button class="qty-btn" onclick="alterarQtdExtra('${a}',1)">+</button>
                </div>
            </td>
        </tr>`;
    }
    html += "</table>";
    document.getElementById("extras-area").innerHTML = html;
}

// Total de copos
function contarTotalCopos() {
    let total = 0;
    for (let sabor in precosAtuais)
        for (let tam in precosAtuais[sabor])
            total += parseInt(document.getElementById(`qtd-${sabor}${tam}`).innerText);
    for (let c in combos)
        total += parseInt(document.getElementById(`qtd-combo-${c}`).innerText) * 2;
    return total;
}

// Atualiza aviso
function atualizarInfoDireitos() {
    const totalCopos = contarTotalCopos();
    document.getElementById("info-direitos").innerText = `Direito até: ${totalCopos} limão(s), ${Math.ceil(totalCopos/2)} molho(s)`;
}

// Ajusta extras caso direito diminua
function ajustarExtrasParaDireitos() {
    const totalCopos = contarTotalCopos();
    const direitoLimao = totalCopos;
    const direitoMolho = Math.ceil(totalCopos / 2);

    const campoLimao = document.getElementById("qtd-limao");
    let qtdLimao = parseInt(campoLimao.innerText);
    if (qtdLimao > direitoLimao) {
        campoLimao.innerText = direitoLimao;
        showTemporaryPopup("Limão: máx. 1 por copo!");
    }

    const campoMolho = document.getElementById("qtd-molho");
    let qtdMolho = parseInt(campoMolho.innerText);
    if (qtdMolho > direitoMolho) {
        campoMolho.innerText = direitoMolho;
        showTemporaryPopup("Molho: máx. 1 a cada 2 copos!");
    }

    atualizarInfoDireitos();
    atualizarTotalDisplay();
}

// Adicionar/remover copos/combos
function alterarQtd(id, delta) {
    const campo = document.getElementById("qtd-" + id);
    let atual = parseInt(campo.innerText);
    atual = Math.max(0, atual + delta);
    campo.innerText = atual;
    ajustarExtrasParaDireitos();
    atualizarTotalDisplay();
}

// Adicionar/remover extras manualmente
function alterarQtdExtra(id, delta) {
    const campo = document.getElementById("qtd-" + id);
    let atual = parseInt(campo.innerText);
    const totalCopos = contarTotalCopos();
    if (id === "limao") {
        if (atual + delta > totalCopos) {
            showTemporaryPopup("Limão: máx. 1 por copo!");
            return;
        }
        atual = Math.max(0, atual + delta);
    } else if (id === "molho") {
        if (atual + delta > Math.ceil(totalCopos/2)) {
            showTemporaryPopup("Molho: máx. 1 a cada 2 copos!");
            return;
        }
        atual = Math.max(0, atual + delta);
    } else {
        atual = Math.max(0, atual + delta);
    }
    campo.innerText = atual;
    atualizarInfoDireitos();
    atualizarTotalDisplay();
}

document.addEventListener("DOMContentLoaded", () => {
    // Aplicar promoções antes de renderizar as tabelas
    const promocoes = aplicarPromocoes();

    // Renderizar tabelas com preços atualizados
    renderTabela("sururu","sururu-area");
    renderTabela("camarao","camarao-area");
    renderTabela("frango","frango-area");
    renderTabela("mocoto","mocoto-area");
    renderTabela("nord","nord-area");
    renderCombos();
    renderExtras();
    atualizarInfoDireitos();
    atualizarTotalDisplay();

    const checkboxDinheiro = document.querySelector('input[name="pagamento"][value="Dinheiro"]');
    const trocoArea = document.getElementById("troco-area");
    const trocoInput = document.getElementById("valor-troco");

    document.querySelectorAll('input[name="pagamento"]').forEach(cb => {
        cb.addEventListener("change", function () {
            if (this.checked) {
                document.querySelectorAll('input[name="pagamento"]').forEach(other => {
                    if (other !== this) other.checked = false;
                });
            }

            if (checkboxDinheiro.checked) {
                trocoArea.style.display = "block";
            } else {
                trocoArea.style.display = "none";
                trocoInput.value = "";
            }
        });
    });

    document.getElementById("btnPedido").onclick = function() {
        let nomeCliente = document.getElementById("nome-cliente").value.trim();
        let observacaoCliente = document.getElementById("observacao-cliente").value.trim();
        let msg = "Gostaria de fazer o seguinte pedido:\n\n";
        let totalPedido = 0;

        for (let sabor in precosAtuais) {
            for (let tam in precosAtuais[sabor]) {
                let qtd = parseInt(document.getElementById(`qtd-${sabor}${tam}`).innerText);
                if(qtd > 0) {
                    let preco = precosAtuais[sabor][tam];
                    let precoOriginal = precosOriginais[sabor][tam];
                    let subtotal = preco * qtd;
                    totalPedido += subtotal;

                    let itemMsg = `* ${nomesCaldos[sabor]} ${letras[tam]} – R$ ${preco.toFixed(2).replace(".", ",")} x${qtd}`;

                    // Adicionar nota sobre desconto se houver

                    msg += itemMsg + `\n`;
                }
            }
        }

        for (let c in combos) {
            let qtd = parseInt(document.getElementById(`qtd-combo-${c}`).innerText);
            if(qtd > 0) {
                let preco = combos[c].preco;
                let subtotal = preco * qtd;
                totalPedido += subtotal;
                msg += `* ${combos[c].nome} – ${combos[c].itens} – R$ ${preco.toFixed(2).replace(".", ",")} x${qtd}\n`;
            }
        }

        for (let a in extras) {
            let qtd = parseInt(document.getElementById(`qtd-${a}`).innerText);
            if(qtd > 0) {
                let preco = extras[a].preco;
                let subtotal = preco * qtd;
                totalPedido += subtotal;
                msg += `* ${extras[a].nome} – R$ ${preco.toFixed(2).replace(".", ",")} x${qtd}\n`;
            }
        }

        if(nomeCliente !== "") {
            msg += `\n*Nome do cliente: ${nomeCliente}*\n`;
        }

        if(observacaoCliente !== "") {
            msg += `\n*Observação: ${observacaoCliente}*\n`;
        }

        msg += `\nTotal do pedido sem o frete: *R$ ${totalPedido.toFixed(2).replace(".", ",")}*`;

        let pagamentoSelecionado = "";
        document.querySelectorAll('input[name="pagamento"]').forEach(cb => {
            if (cb.checked) pagamentoSelecionado = cb.value;
        });

        if (pagamentoSelecionado !== "") {
            msg += `\nForma de pagamento: *${pagamentoSelecionado}*`;

            if (pagamentoSelecionado === "Dinheiro") {
                let trocoRaw = document.getElementById("valor-troco").value.trim();

                if (trocoRaw !== "") {
                    trocoRaw = trocoRaw.replace(",", ".");
                    let trocoNumero = parseFloat(trocoRaw);

                    if (!isNaN(trocoNumero)) {
                        let trocoFormatado = trocoNumero.toFixed(2).replace(".", ",");
                        msg += `, *troco\excedente: R$ ${trocoFormatado}*`;
                    }
                }
            }
        }

        window.open("https://api.whatsapp.com/send?phone=5575991211138&text="+encodeURIComponent(msg), "_blank");
    };
});
</script>

